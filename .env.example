# Database (Supabase pooled URI, port 6543)
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.jawedpumps.com
NEXT_PUBLIC_SITE_URL=https://www.jawedpumps.com

# Admin seed (local / first deploy)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------------------
# Email — Outlook / Microsoft 365 (recommended for jawedmotors@outlook.com)
# Create an app password: https://account.microsoft.com/security → App passwords
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jawedmotors@outlook.com
SMTP_PASS=
EMAIL_FROM=Jawed Pumps & Motors <jawedmotors@outlook.com>

# Alternative: Resend (https://resend.com) — requires domain verification for production
# RESEND_API_KEY=
# EMAIL_FROM=Jawed Pumps & Motors <orders@jawedpumps.com>

# Owner alerts when NEW orders arrive (also editable in Admin → Settings)
OWNER_NOTIFY_EMAIL=jawedmotors@outlook.com
OWNER_NOTIFY_WHATSAPP=03053770002

# ---------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (https://developers.facebook.com)
# WHATSAPP_TOKEN = permanent access token from Meta Business
# WHATSAPP_PHONE_NUMBER_ID = from WhatsApp → API Setup in Meta dashboard
# WHATSAPP_VERIFY_TOKEN = random string you choose (must match Meta webhook setup)
# WHATSAPP_AUTO_REPLY = true to send instant reply when customers WhatsApp you
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTO_REPLY=false

# Approved Meta message templates (utility category). Create in Meta Business Manager → WhatsApp → Message templates.
# Variable order must match docs/NOTIFICATIONS_SETUP.md
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRM=
WHATSAPP_TEMPLATE_ORDER_DISPATCH=
WHATSAPP_TEMPLATE_ORDER_CANCEL=
WHATSAPP_TEMPLATE_OWNER_NEW_ORDER=

# Supabase Storage (admin image uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
