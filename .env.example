# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL) — Supabase, Neon, Vercel Postgres, or any Postgres host
# ---------------------------------------------------------------------------
# The storefront renders from bundled demo data even WITHOUT this set, so your
# first deploy won't crash. Set it to enable the admin dashboard, real orders,
# and inventory persistence, then run: npm run db:push && npm run db:seed
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# AUTH (NextAuth) — used for the /admin dashboard login
# ---------------------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# In production set this to your deployed URL, e.g. https://your-store.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (created by `npm run db:seed`). Change before going live.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"

# ---------------------------------------------------------------------------
# ORDER NOTIFICATIONS (optional) — email + WhatsApp to owner & customer
# ---------------------------------------------------------------------------
# The owner's notify email/number are set in the admin dashboard (/admin/settings).
# These env vars just provide the SENDING providers. Without them, messages are
# logged to the server console so nothing breaks.

# --- Email: use EITHER Resend (easiest) OR SMTP ---
# Resend — sign up at https://resend.com, create an API key:
RESEND_API_KEY=""
EMAIL_FROM="Your Store <orders@yourdomain.com>"
# OR classic SMTP (e.g. Gmail, your host). Leave RESEND_API_KEY blank to use this:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- WhatsApp: Meta WhatsApp Cloud API ---
# Create an app at https://developers.facebook.com → WhatsApp → get a permanent
# token and the phone number ID. (Business-initiated messages may require an
# approved message template.)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Fallback owner contacts if you haven't set them in /admin/settings yet:
OWNER_NOTIFY_EMAIL=""
OWNER_NOTIFY_WHATSAPP=""
