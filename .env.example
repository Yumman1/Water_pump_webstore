# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL) — Supabase, Neon, Vercel Postgres, or any Postgres host
# ---------------------------------------------------------------------------
# Prefer DATABASE_URL. On Vercel Marketplace integrations you may also get
# POSTGRES_URL / POSTGRES_PRISMA_URL — the app accepts those as aliases.
# The storefront renders from bundled demo data even WITHOUT this set.
# Set it to enable admin writes, real orders, and inventory, then run:
#   npm run db:push && npm run db:seed
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# AUTH (NextAuth) — used for the /admin dashboard login
# ---------------------------------------------------------------------------
# REQUIRED on Vercel / production (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# In production set this to your deployed URL, e.g. https://your-store.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (created by `npm run db:seed`). Change before going live.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"

# ---------------------------------------------------------------------------
# ORDER NOTIFICATIONS — email (Resend) + WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Owner contacts can also be edited in /admin/settings after login.

# Resend — https://resend.com → API Keys
RESEND_API_KEY=""
EMAIL_FROM="Jawed <orders@yourdomain.com>"
# OR classic SMTP (leave RESEND_API_KEY blank to use this):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# WhatsApp Cloud API — developers.facebook.com → WhatsApp
# Business-initiated messages often need an approved message template.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Fallback owner contacts until set in /admin/settings:
OWNER_NOTIFY_EMAIL="jawedmotors@outlook.com"
OWNER_NOTIFY_WHATSAPP="0304-1088901"
